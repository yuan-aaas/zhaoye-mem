{
  "name": "dsh-plugin-zhaoye",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assistant": {
      "types": "./dist/assistant.d.ts",
      "import": "./dist/assistant.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@zhaoye/adapter-kit": "workspace:*",
    "@zhaoye/app": "workspace:*",
    "@zhaoye/contracts": "workspace:*"
  }
}
